---
import { projects } from '../data/projects';
import { projectShots } from '../lib/assets';
import Button from './ui/Button.astro';
import Shot from './ui/Shot.astro';

const items = projects.map((p) => {
  const shots = projectShots(p.slug);
  const n = p.shots === 'phone' ? 3 : Math.min(Math.max(shots.length, 1), 3);
  const frames = Array.from({ length: n }, (_, i) => shots[i] ?? null);
  return { ...p, frames };
});
---
<section id="work" class="section work" aria-labelledby="work-title">
  <div class="container">
    <header class="work__head">
      <h2 class="h2" id="work-title">Selected work</h2>
      <p class="work__sub">A collection of things I’ve built, researched and experimented with.</p>
    </header>

    <div class="work__body" data-work>
      <div class="work__list" role="tablist" aria-label="Projects" aria-orientation="vertical">
        {items.map((p, i) => (
          <button type="button" role="tab" id={`tab-${p.slug}`} aria-controls={`panel-${p.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="work__tab">
            <span class="work__num tnum">{p.num}</span>
            <span class="work__name">{p.title}</span>
            <span class="work__cat">{p.category} · {p.year}</span>
          </button>
        ))}
      </div>

      <div class="work__panels">
        {items.map((p, i) => (
          <div class:list={['panel', `panel--${p.shots}`, { 'is-active': i === 0 }]} role="tabpanel" id={`panel-${p.slug}`} aria-labelledby={`tab-${p.slug}`} tabindex="0">
            <div class="panel__text">
              <p class="meta panel__meta"><span class="tnum">{p.num} / 06</span><span>{p.type} · {p.year}</span></p>
              <h3 class="panel__title">{p.title}</h3>
              <p class="panel__sum">{p.summary}</p>
              {p.metric && <p class="panel__metric"><span class="dot"></span>{p.metric}</p>}
              <p class="panel__stack"><span aria-hidden="true">→</span> {p.stack.join(' · ')}</p>
              <div class="panel__cta">
                <Button href={`/work/${p.slug}`} variant="primary" icon="arrow">View project</Button>
                {p.links.store && <Button href={p.links.store} icon="arrow-up-right" external>Google Play</Button>}
                {p.links.github && <Button href={p.links.github} icon="arrow-up-right" external>GitHub</Button>}
              </div>
            </div>
            <div class:list={['panel__media', `panel__media--n${p.frames.length}`]}>
              {p.frames.map((src, k) => (
                <Shot src={src} frame={p.shots} alt={`${p.title} screenshot ${k + 1}`} slotPath={`work/${p.slug}/${k + 1}.png`} slotLabel={p.shots === 'phone' ? `Screen ${k + 1}` : `${p.title} visual`} compact={p.shots === 'phone'} class={`panel__shot panel__shot--${k}`} eager={i === 0} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .work__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem 2rem; flex-wrap: wrap; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .work__sub { color: var(--ink-3); }
  .work__body { display: grid; grid-template-columns: minmax(0, 3.6fr) minmax(0, 8.4fr); gap: clamp(1.5rem, 3vw, 3.5rem); align-items: start; }

  .work__list { display: flex; flex-direction: column; border-top: 1px solid var(--line); position: sticky; top: 6rem; }
  .work__tab { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); text-align: left; padding: 1.05rem 0 1.05rem 1rem; border-bottom: 1px solid var(--line); position: relative; transition: background var(--t-fast); }
  .work__tab::before { content: ""; position: absolute; left: 0; top: .9rem; bottom: .9rem; width: 2px; background: var(--lime); transform: scaleY(0); transition: transform var(--t) var(--ease); }
  .work__tab[aria-selected="true"]::before { transform: scaleY(1); }
  .work__tab[aria-selected="true"] { background: var(--bg-2); }
  .work__num { font-family: var(--f-mono); font-size: .75rem; color: var(--ink-3); padding-top: .2rem; grid-row: span 2; }
  .work__tab[aria-selected="true"] .work__num { color: var(--lime); }
  .work__name { font-weight: 500; font-size: 1.02rem; color: var(--ink-2); transition: color var(--t-fast); }
  .work__tab:hover .work__name, .work__tab[aria-selected="true"] .work__name { color: var(--ink); }
  .work__cat { font-size: .82rem; color: var(--ink-3); }

  /* one structure for every project: words left, screens right */
  .panel { display: grid; grid-template-columns: minmax(0, 4.5fr) minmax(0, 7fr); align-items: center; gap: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem); background: var(--bg-2); }
  :global(.js) .panel:not(.is-active) { display: none; }
  .panel__meta { display: flex; gap: 1rem; }
  .panel__title { margin-top: 1rem; font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.8rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.02; }
  .panel__sum { margin-top: 1rem; color: var(--ink-2); max-width: 46ch; }
  .panel__metric { margin-top: 1.1rem; display: inline-flex; align-items: center; gap: .55rem; font-family: var(--f-mono); font-size: .8rem; }
  .panel__stack { margin-top: 1rem; font-family: var(--f-mono); font-size: .74rem; line-height: 1.7; color: var(--ink-3); max-width: 46ch; }
  .panel__stack span { color: var(--lime); }
  .panel__cta { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: .6rem; }

  .panel__media { display: flex; justify-content: center; align-items: flex-end; gap: clamp(.6rem, 1.4vw, 1.2rem); min-width: 0; }
  .panel--phone .panel__media { padding-block: .5rem 1rem; }
  .panel--phone :global(.panel__shot) { width: 31%; }
  .panel--phone :global(.panel__shot--1) { transform: translateY(-1.5rem); }
  /* wide visuals: one fills the column; several overlap like a small stack */
  .panel--wide .panel__media { display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; }
  .panel--wide :global(.panel__shot) { width: 100%; aspect-ratio: 16 / 10; }
  .panel--wide .panel__media--n2, .panel--wide .panel__media--n3 { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto auto; padding-block: .5rem; }
  .panel--wide .panel__media--n2 :global(.panel__shot--0) { grid-area: 1 / 1 / 2 / 11; }
  .panel--wide .panel__media--n2 :global(.panel__shot--1) { grid-area: 1 / 4 / 2 / 13; transform: translateY(18%); box-shadow: 0 -12px 40px rgba(0, 0, 0, .45); }
  .panel--wide .panel__media--n3 :global(.panel__shot--0) { grid-area: 1 / 1 / 2 / 13; }
  .panel--wide .panel__media--n3 :global(.panel__shot--1) { grid-area: 2 / 1 / 3 / 7; margin-top: .8rem; }
  .panel--wide .panel__media--n3 :global(.panel__shot--2) { grid-area: 2 / 7 / 3 / 13; margin-top: .8rem; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .panel.is-active { animation: panelIn .6s var(--ease) both; }
    :global(.js) .panel.is-active :global(.panel__shot) { animation: shotIn .8s var(--ease) both; }
    :global(.js) .panel.is-active :global(.panel__shot--1) { animation-delay: .06s; } :global(.js) .panel.is-active :global(.panel__shot--2) { animation-delay: .12s; }
    @keyframes panelIn { from { opacity: 0; } }
    @keyframes shotIn { from { opacity: 0; translate: 0 16px; } }
  }

  @container main (max-width: 980px) { .panel { grid-template-columns: minmax(0, 1fr); } .panel--phone :global(.panel__shot) { width: 28%; max-width: 200px; } }

  /* phones & small tablets: every project stacked, no tabs */
  @container main (max-width: 720px) {
    .work__body { grid-template-columns: minmax(0, 1fr); }
    .work__list { display: none; }
    .work__panels { display: grid; gap: 1rem; }
    :global(.js) .panel:not(.is-active) { display: grid; }
    :global(.js) .panel.is-active { animation: none; }
    .panel--phone :global(.panel__shot) { width: 31%; }
    .panel--phone :global(.panel__shot--1) { transform: translateY(-.8rem); }
  }
</style>

<script is:inline>
(() => {
  const root = document.querySelector('[data-work]'); if (!root) return;
  const tabs = [...root.querySelectorAll('[role="tab"]')];
  const select = (t, focus) => {
    tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', on); x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')).classList.toggle('is-active', on); });
    if (focus) t.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const k = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (k) { e.preventDefault(); select(tabs[(i + k + tabs.length) % tabs.length], true); }
      if (e.key === 'Home') { e.preventDefault(); select(tabs[0], true); }
      if (e.key === 'End') { e.preventDefault(); select(tabs[tabs.length - 1], true); }
    });
  });
})();
</script>
