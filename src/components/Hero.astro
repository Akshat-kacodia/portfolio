---
// Home top: a little desk device. The screen describes each key; pressing a key
// takes you to that part of the page.
import { site } from '../data/site';
import Icon from './ui/Icon.astro';

const rail = [
  { n: '01', t: 'top', label: 'Home' }, { n: '02', t: 'about', label: 'About' }, { n: '03', t: 'work', label: 'Work' },
  { n: '04', t: 'stack', label: 'Stack' }, { n: '05', t: 'gallery', label: 'Gallery' }, { n: '06', t: 'contact', label: 'Contact' },
];

type Key = { glyph: string; label: string; short: string; href: string; title: string; desc: string; tone: string; ext?: boolean };
const row1: Key[] = [
  { glyph: 'A', label: 'About me', short: 'About', href: '#about', title: 'About me', desc: 'Who I am, what I study and what I’m doing next.', tone: 'cream' },
  { glyph: 'K', label: 'Selected work', short: 'Work', href: '#work', title: 'Selected work', desc: 'Android apps and AI/ML research I’ve built.', tone: 'lime' },
  { glyph: 'S', label: 'Tech stack', short: 'Stack', href: '#stack', title: 'Tech stack', desc: 'The languages, frameworks and tools I use most.', tone: 'sand' },
  { glyph: 'H', label: 'Gallery', short: 'Gallery', href: '#gallery', title: 'Gallery', desc: 'Moments from events, teams and things I’ve been part of.', tone: 'moss' },
  { glyph: 'A', label: 'Contact', short: 'Contact', href: '#contact', title: 'Contact', desc: 'Have an idea? Let’s build it.', tone: 'graphite' },
  { glyph: 'T', label: 'Résumé', short: 'Résumé', href: site.resume, title: 'Résumé', desc: 'Open my résumé in a new tab.', tone: 'cream', ext: true },
];
const row2 = [
  { icon: 'github' as const, label: 'GitHub', href: site.github, title: 'GitHub', desc: 'github.com/Akshat-kacodia', tone: 'graphite', ext: true },
  { icon: 'linkedin' as const, label: 'LinkedIn', href: site.linkedin, title: 'LinkedIn', desc: 'Let’s connect on LinkedIn.', tone: 'graphite', ext: true },
  { icon: 'code' as const, label: 'LeetCode', href: site.leetcode, title: 'LeetCode', desc: 'leetcode.com/u/Akshat_kacodia', tone: 'graphite', ext: true },
  { icon: 'mail' as const, label: 'Email', href: `mailto:${site.email}`, title: 'Email', desc: site.email, tone: 'graphite', ext: false },
];
---
<section id="top" class="hero" aria-labelledby="hero-title">
  <nav class="hero__rail" aria-label="Section index" data-rail>
    {rail.map((r) => <a href={`#${r.t}`} data-target={r.t} class="tnum" aria-label={`${r.n} ${r.label}`}>{r.n}</a>)}
  </nav>

  <div class="container hero__in">
    <h1 class="hero__title" id="hero-title" data-intro style="--i:1">Hi, I’m <span class="lime">Akshat</span></h1>
    <p class="hero__tag" data-intro style="--i:2">I build things I believe should exist.</p>

    <div class="kb-stage" data-intro style="--i:3">
      <div class="kb" data-kb>
        <!-- lid with the screen -->
        <div class="kb__lid">
          <i class="screw s1"></i><i class="screw s2"></i><i class="screw s3"></i><i class="screw s4"></i>
          <div class="kb__screen" aria-live="polite">
            <div class="kb__bar"><span>akshat / index</span><span class="kb__bar-r">{site.role}</span></div>
            <p class="kb__title"><span data-kb-title>Hello, world</span><i class="kb__caret" aria-hidden="true"></i></p>
            <p class="kb__desc" data-kb-desc>// turning ideas into software people can use. Press a key to explore.</p>
          </div>
        </div>

        <div class="kb__hinge" aria-hidden="true"><span></span></div>

        <!-- deck with the keys -->
        <div class="kb__deck">
          <i class="screw s1"></i><i class="screw s2"></i><i class="screw s3"></i><i class="screw s4"></i>
          <nav class="kb__keys" aria-label="Explore the site">
            <div class="kb__well kb__row1">
              {row1.map((k) => (
                <a class={`key key--${k.tone}`} href={k.href} data-key data-title={k.title} data-desc={k.desc}
                   target={k.ext ? '_blank' : undefined} rel={k.ext ? 'noopener' : undefined} aria-label={k.label}>
                  <span class="key__cap"><span class="key__glyph" aria-hidden="true">{k.glyph}</span><span class="key__label" aria-hidden="true"><span class="key__long">{k.label}</span><span class="key__short">{k.short}</span></span></span>
                </a>
              ))}
            </div>
            <div class="kb__well kb__row2">
              {row2.map((k) => (
                <a class={`key key--sm key--${k.tone}`} href={k.href} data-key data-title={k.title} data-desc={k.desc}
                   target={k.ext ? '_blank' : undefined} rel={k.ext ? 'noopener' : undefined} aria-label={k.label}>
                  <span class="key__cap"><Icon name={k.icon} size={20} class="key__icon" /><span class="key__label" aria-hidden="true">{k.label}</span></span>
                </a>
              ))}
              <a class="key key--enter key--ink" href="#contact" data-key data-title="Let’s talk" data-desc="Open to internships, collaborations and new ideas." aria-label="Let’s talk">
                <span class="key__cap">
                  <svg class="key__return" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 5v7a3 3 0 0 1-3 3H6m0 0 4-4m-4 4 4 4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span class="key__enter-label" aria-hidden="true">Let’s talk</span>
                </span>
              </a>
            </div>
          </nav>
        </div>
      </div>
      <div class="kb__shadow" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: clamp(1.5rem, 4svh, 3rem) clamp(3rem, 7svh, 5rem); overflow: hidden; }
  .hero::before { content: ""; position: absolute; left: 50%; top: 55%; width: min(1100px, 120vw); aspect-ratio: 2 / 1; translate: -50% -50%; background: radial-gradient(closest-side, rgba(198, 240, 90, .07), transparent 70%); pointer-events: none; }

  /* section rail (fixed, follows the scroll) */
  .hero__rail { position: fixed; z-index: 40; top: 50%; translate: 0 -50%; left: max(.9rem, calc((100vw - var(--max)) / 2 - 1.25rem)); display: flex; flex-direction: column; gap: .9rem; font-family: var(--f-mono); font-size: .72rem; color: var(--ink-3); }
  .hero__rail a { position: relative; width: max-content; padding-block: .1rem; transition: color var(--t-fast); }
  .hero__rail a:hover { color: var(--ink); }
  .hero__rail a.on { color: var(--lime); }
  .hero__rail a.on::after { content: ""; display: block; width: 1px; height: 2.6rem; background: var(--lime); margin: .6rem 0 0 .35rem; }

  .hero__in { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero__title { margin-top: 0; font-size: clamp(2.4rem, 1.4rem + 3.6vw, 4.4rem); font-weight: 600; letter-spacing: -.05em; line-height: 1; }
  .hero__tag { margin-top: .9rem; font-size: clamp(1.02rem, .95rem + .35vw, 1.25rem); color: var(--ink-2); }

  /* ───────── the device ───────── */
  .kb-stage { position: relative; width: min(100%, 860px, max(540px, calc((100svh - 330px) * 1.37))); margin-top: clamp(1.75rem, 4.5svh, 3rem); perspective: 1800px; }
  .kb { --metal-hi: #8d918d; --metal: #3a3d3b; --metal-lo: #151615; container-type: inline-size; transform: rotateX(8deg) rotateY(var(--ry, 0deg)); transform-style: preserve-3d; transition: transform .6s var(--ease); }
  .kb__shadow { position: absolute; left: 8%; right: 8%; bottom: -2.5rem; height: 3rem; background: radial-gradient(closest-side, rgba(0, 0, 0, .7), transparent); filter: blur(6px); z-index: -1; }

  .kb__lid, .kb__deck {
    position: relative; border-radius: 6cqi;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, .025) 0 1px, transparent 1px 3px),
      linear-gradient(180deg, #5a5e5b 0%, var(--metal) 18%, #262826 60%, var(--metal-lo) 100%);
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, .38), inset 0 -2px 0 rgba(0, 0, 0, .7),
      inset 2px 0 0 rgba(255, 255, 255, .06), inset -2px 0 0 rgba(0, 0, 0, .4),
      0 0 0 1px #070807, 0 2.4cqi 4cqi -1cqi rgba(0, 0, 0, .75);
  }
  .kb__lid { margin-inline: 4cqi; padding: 3.2cqi 4cqi; }
  .kb__deck { padding: 3.6cqi 3.6cqi; }

  .screw { position: absolute; width: 1.7cqi; height: 1.7cqi; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #d9dcd8, #6a6e6b 45%, #2a2c2b 75%); box-shadow: 0 0 0 1px rgba(0, 0, 0, .6), inset 0 0 0 .3cqi rgba(0, 0, 0, .15); }
  .screw::after { content: ""; position: absolute; inset: 46% 18%; background: rgba(0, 0, 0, .55); transform: rotate(35deg); }
  .s1 { top: 1.6cqi; left: 1.8cqi; } .s2 { top: 1.6cqi; right: 1.8cqi; } .s3 { bottom: 1.6cqi; left: 1.8cqi; } .s4 { bottom: 1.6cqi; right: 1.8cqi; }

  /* screen */
  .kb__screen {
    position: relative; overflow: hidden; text-align: left; border-radius: 2.6cqi; padding: 2.2cqi 3cqi 2.6cqi;
    background: radial-gradient(120% 140% at 30% 0%, #141a10, #070906 70%);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .9), inset 0 .6cqi 1.6cqi rgba(0, 0, 0, .9), 0 1px 0 rgba(255, 255, 255, .12);
  }
  .kb__screen::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgba(255, 255, 255, .025) 0 1px, transparent 1px 3px), linear-gradient(115deg, rgba(255, 255, 255, .06), transparent 40%); pointer-events: none; }
  .kb__bar { display: flex; justify-content: space-between; gap: 1rem; font-family: var(--f-mono); font-size: max(.58rem, 1.15cqi); letter-spacing: .14em; text-transform: uppercase; color: rgba(198, 240, 90, .75); }
  .kb__bar-r { color: rgba(237, 238, 232, .38); text-align: right; }
  .kb__title { margin-top: 1.4cqi; display: flex; align-items: center; min-height: 1.2em; font-family: var(--f-mono); font-weight: 700; font-size: max(1.35rem, 4.6cqi); letter-spacing: -.02em; color: #eef6d8; text-shadow: 0 0 1.4cqi rgba(198, 240, 90, .35); white-space: nowrap; }
  .kb__caret { display: inline-block; width: .5em; height: .95em; margin-left: .12em; background: var(--lime); box-shadow: 0 0 1cqi rgba(198, 240, 90, .6); }
  .kb__desc { margin-top: 1cqi; font-family: var(--f-mono); font-size: max(.7rem, 1.45cqi); color: rgba(237, 238, 232, .62); min-height: 1.5em; }

  /* hinge */
  .kb__hinge { position: relative; height: 3.4cqi; display: flex; justify-content: center; }
  .kb__hinge span { width: 16cqi; height: 100%; border-radius: .8cqi; background: repeating-linear-gradient(90deg, #5d5a46 0 .45cqi, #c6b98a .45cqi .75cqi, #2c2a20 .75cqi 1.1cqi); box-shadow: inset 0 .5cqi .6cqi rgba(255, 255, 255, .25), inset 0 -.6cqi .6cqi rgba(0, 0, 0, .55), 0 0 0 1px #0a0a0a; }

  /* key wells */
  .kb__keys { display: grid; gap: 2.2cqi; }
  .kb__well { display: grid; gap: 1.8cqi; padding: 1.8cqi 1.8cqi 2.4cqi; border-radius: 3cqi; background: linear-gradient(180deg, #0b0c0b, #151615); box-shadow: inset 0 .8cqi 1.6cqi rgba(0, 0, 0, .9), inset 0 -1px 0 rgba(255, 255, 255, .06), 0 1px 0 rgba(255, 255, 255, .1); }
  .kb__row1 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .kb__row2 { grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(0, 2.4fr); }

  /* keys */
  .key { --d: 1.1cqi; --top: #e9e6d8; --top2: #cfccbd; --side: #9d9a8b; --ink: #1d1e1b; --sub: rgba(29, 30, 27, .6);
    display: block; padding-bottom: var(--d); border-radius: 2cqi; outline: none; -webkit-tap-highlight-color: transparent; }
  .key__cap {
    position: relative; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start;
    aspect-ratio: 1 / .92; padding: 1.2cqi 1.3cqi 1.1cqi; border-radius: 2cqi; color: var(--ink);
    background: linear-gradient(180deg, var(--top), var(--top2));
    box-shadow:
      0 var(--d) 0 var(--side), 0 calc(var(--d) + .8cqi) 1.6cqi rgba(0, 0, 0, .55),
      inset 0 .25cqi 0 rgba(255, 255, 255, .55), inset 0 -.5cqi 1cqi rgba(0, 0, 0, .14), inset 0 0 0 1px rgba(0, 0, 0, .12);
    transition: transform .12s var(--ease), box-shadow .12s var(--ease), filter .2s;
  }
  .key__cap::before { content: ""; position: absolute; inset: 9% 9% 22%; border-radius: 1.4cqi; background: radial-gradient(120% 90% at 50% 0%, rgba(255, 255, 255, .28), transparent 70%); pointer-events: none; }
  .key__glyph { font-family: var(--f-display); font-weight: 800; font-stretch: 80%; font-variation-settings: "wdth" 80; font-size: max(1.15rem, 4.4cqi); line-height: 1; }
  .key__label { font-family: var(--f-mono); font-size: max(.5rem, 1cqi); letter-spacing: .08em; text-transform: uppercase; color: var(--sub); line-height: 1.1; text-align: left; }
  .key__short { display: none; }
  .key--sm .key__cap { aspect-ratio: auto; height: 100%; min-height: 7.4cqi; }
  .key :global(.key__icon) { width: max(16px, 2.6cqi); height: max(16px, 2.6cqi); }

  .key--lime { --top: #d4f77a; --top2: #b7e044; --side: #7d9d22; }
  .key--moss { --top: #5f7d36; --top2: #4a6527; --side: #2e4116; --ink: #eef3df; --sub: rgba(238, 243, 223, .65); }
  .key--sand { --top: #e4c88c; --top2: #cfae6c; --side: #96773f; }
  .key--graphite { --top: #3b3e3c; --top2: #2c2e2d; --side: #151615; --ink: #e9ebe4; --sub: rgba(233, 235, 228, .55); }
  .key--ink { --top: #1f2120; --top2: #141514; --side: #050605; --ink: #edeee8; --sub: rgba(237, 238, 232, .6); }

  .key--enter .key__cap { aspect-ratio: auto; height: 100%; flex-direction: row; align-items: center; justify-content: space-between; padding-inline: 2.4cqi; }
  .key__return { width: max(22px, 4cqi); height: max(22px, 4cqi); color: var(--lime); }
  .key__enter-label { font-family: var(--f-mono); font-weight: 600; font-size: max(.6rem, 1.4cqi); letter-spacing: .14em; text-transform: uppercase; }

  @media (hover: hover) {
    .key:hover .key__cap { transform: translateY(-.3cqi); filter: brightness(1.05); }
  }
  .key:focus-visible .key__cap { box-shadow: 0 var(--d) 0 var(--side), 0 0 0 3px var(--bg), 0 0 0 5px var(--lime); }
  .key.is-down .key__cap, .key:active .key__cap { transform: translateY(var(--d)); box-shadow: 0 0 0 var(--side), 0 .3cqi .6cqi rgba(0, 0, 0, .5), inset 0 .25cqi 0 rgba(255, 255, 255, .4), inset 0 -.3cqi .6cqi rgba(0, 0, 0, .18), inset 0 0 0 1px rgba(0, 0, 0, .15); }

  @media (prefers-reduced-motion: no-preference) {
    .hero__dot { animation: pulse 2.4s ease-in-out infinite; }
    @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(198, 240, 90, .45); } 50% { box-shadow: 0 0 0 7px rgba(198, 240, 90, 0); } }
    .kb__caret { animation: blink 1.05s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    [data-intro] { animation: fadeUp 1s var(--ease) both; animation-delay: calc(var(--i) * 90ms + 80ms); }
    .kb-stage[data-intro] { animation: deviceIn 1.2s var(--ease) both; animation-delay: .3s; }
    @keyframes fadeUp { from { transform: translateY(14px); opacity: 0; } }
    @keyframes deviceIn { from { transform: translateY(40px) scale(.97); opacity: 0; } }
  }
  @media (prefers-reduced-motion: reduce) { .kb { transform: none; } }

  @media (max-width: 1024px) { .hero__rail { display: none; } }
  /* phones: 3 × 2 letter keys, each labelled with the section it opens */
  @media (max-width: 640px) {
    .kb { transform: none; }
    .kb__lid { margin-inline: 2.5cqi; padding: 4cqi; }
    .kb__deck { padding: 4.5cqi 3.4cqi; }
    .kb__bar-r { display: none; }
    .kb__title { font-size: 6.4cqi; }
    .kb__desc { font-size: 3.3cqi; }
    .kb__keys { gap: 3cqi; }
    .kb__well { gap: 2.6cqi; padding: 2.6cqi 2.6cqi 3.6cqi; border-radius: 4.5cqi; }
    .kb__row1 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .key { --d: 1.6cqi; }
    .key__cap { aspect-ratio: 1.45 / 1; padding: 2.4cqi 2.6cqi 2.2cqi; border-radius: 3.2cqi; }
    .key__glyph { font-size: 8cqi; }
    .key__label { font-size: max(.62rem, 2.8cqi); letter-spacing: .06em; font-weight: 600; }
    .key__long { display: none; } .key__short { display: inline; }
    .kb__row2 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .key--sm .key__cap { min-height: 15cqi; padding: 2.2cqi 2.4cqi; gap: 1cqi; }
    .key--sm .key__label { font-size: max(.55rem, 2.3cqi); }
    .key--enter { grid-column: 1 / -1; }
    .key--enter .key__cap { min-height: 12cqi; padding-inline: 4cqi; }
    .key__enter-label { font-size: 3cqi; }
    .s1, .s2 { top: 1.4cqi; } .s3, .s4 { bottom: 1.4cqi; }
  }
</style>

<script is:inline>
(() => {
  /* rail: highlight the section in view */
  const rail = [...document.querySelectorAll('[data-rail] a')];
  if (rail.length) {
    const ids = rail.map(a => a.dataset.target);
    const spy = () => {
      let cur = ids[0];
      for (const id of ids) { const s = document.getElementById(id); if (s && s.getBoundingClientRect().top < innerHeight * .4) cur = id; }
      rail.forEach(a => a.classList.toggle('on', a.dataset.target === cur));
    };
    addEventListener('scroll', spy, { passive: true }); spy();
  }

  const kb = document.querySelector('[data-kb]'); if (!kb) return;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const titleEl = kb.querySelector('[data-kb-title]'), descEl = kb.querySelector('[data-kb-desc]');
  const home = { t: titleEl.textContent, d: descEl.textContent };
  let timer = 0, current = '';

  const show = (t, d) => {
    if (t === current) return; current = t;
    clearInterval(timer); descEl.textContent = d;
    if (reduce) { titleEl.textContent = t; return; }
    let i = 0; titleEl.textContent = '';
    timer = setInterval(() => { titleEl.textContent = t.slice(0, ++i); if (i >= t.length) clearInterval(timer); }, 38);
  };
  let leaveT = 0;
  const reset = () => { clearTimeout(leaveT); leaveT = setTimeout(() => show(home.t, home.d), 900); };

  kb.querySelectorAll('[data-key]').forEach((k) => {
    const on = () => { clearTimeout(leaveT); show(k.dataset.title, k.dataset.desc); };
    k.addEventListener('pointerenter', on); k.addEventListener('focus', on);
    k.addEventListener('pointerleave', reset); k.addEventListener('blur', reset);
    k.addEventListener('click', (e) => {
      const href = k.getAttribute('href') || '';
      k.classList.add('is-down'); setTimeout(() => k.classList.remove('is-down'), 180);
      if (href.startsWith('#')) {
        e.preventDefault(); on();
        setTimeout(() => { document.querySelector(href)?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' }); history.replaceState(null, '', href); }, 220);
      }
    });
  });

  /* gentle tilt that follows the pointer */
  if (!reduce && matchMedia('(pointer: fine)').matches) {
    addEventListener('pointermove', (e) => {
      const x = e.clientX / innerWidth - .5;
      kb.style.setProperty('--ry', `${(x * 6).toFixed(2)}deg`);
    }, { passive: true });
  }
})();
</script>
