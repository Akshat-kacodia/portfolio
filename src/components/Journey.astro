---
// Timeline content is paused for now. The data still lives in site.ts (`journey`)
// so it can come back by restoring the earlier version of this component.
---
<section id="journey" class="section journey" aria-labelledby="journey-title">
  <div class="container">
    <header class="j__head" data-reveal>
      <h2 class="h2" id="journey-title">Experience &amp; journey</h2>
      <p class="j__sub">A timeline of what I’ve been building and learning.</p>
    </header>

    <div class="soon" data-reveal>
      <div class="soon__line" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span class="on"></span>
      </div>
      <p class="soon__tag meta"><span class="dot soon__dot"></span>Coming soon</p>
      <p class="soon__text">This section is being updated. Check back shortly.</p>
    </div>
  </div>
</section>

<style>
  .journey { border-top: 1px solid var(--line); }
  .j__head { display: grid; gap: .75rem; margin-bottom: clamp(2rem, 1.5rem + 2.5vw, 3.5rem); }
  .j__sub { color: var(--ink-3); }

  .soon { border: 1px dashed var(--line-2); border-radius: var(--r-lg); padding: clamp(2rem, 1.5rem + 3vw, 3.5rem) clamp(1.25rem, 1rem + 2vw, 2.5rem); display: grid; justify-items: center; text-align: center; gap: 1rem; }
  .soon__line { width: min(100%, 36rem); display: flex; justify-content: space-between; position: relative; margin-bottom: 1rem; }
  .soon__line::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: repeating-linear-gradient(90deg, var(--line-2) 0 6px, transparent 6px 12px); }
  .soon__line span { width: 9px; height: 9px; border-radius: 50%; border: 1px solid var(--line-2); background: var(--bg); position: relative; }
  .soon__line span.on { border-color: var(--lime); background: var(--lime); }
  .soon__tag { display: inline-flex; align-items: center; gap: .55rem; color: var(--ink-2); }
  .soon__text { color: var(--ink-3); max-width: 40ch; }
  @media (prefers-reduced-motion: no-preference) {
    .soon__dot, .soon__line span.on { animation: soonPulse 2.4s ease-in-out infinite; }
    @keyframes soonPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(198, 240, 90, .45); } 50% { box-shadow: 0 0 0 6px rgba(198, 240, 90, 0); } }
  }
</style>
