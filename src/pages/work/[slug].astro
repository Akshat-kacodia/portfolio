---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import Shot from '../../components/ui/Shot.astro';
import { projects, type Project } from '../../data/projects';
import { projectShots } from '../../lib/assets';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, i } }));
}
const { p, i } = Astro.props as { p: Project; i: number };
const next = projects[(i + 1) % projects.length];
const phone = p.shots === 'phone';
const shots = projectShots(p.slug);
const heroFrames = Array.from({ length: phone ? 2 : 1 }, (_, k) => shots[k] ?? null);
const factIcon = (k: string) => (/platform|runs/i.test(k) ? 'device' : /user|for/i.test(k) ? 'users' : /data|class|task/i.test(k) ? 'data' : 'layers') as 'device' | 'users' | 'data' | 'layers';
const tabs = [
  { id: 'overview', t: 'Overview' }, { id: 'problem', t: 'Problem' }, { id: 'solution', t: 'Solution' },
  { id: 'tech', t: 'Tech Stack' }, { id: 'features', t: 'Features' }, { id: 'outcome', t: 'Outcome' },
];
const gh = p.links.github === null ? null : (p.links.github || site.github);
---
<Base title={`${p.title} — ${site.name}`} description={`${p.title}: ${p.oneLiner} ${p.summary}`} active="work">
  <article class="cs">
    <div class="container">
      <nav class="cs__bar" aria-label="Breadcrumb">
        <a href="/#work" class="cs__back"><Icon name="arrow-left" size={15} /> Back to all projects</a>
        <span class="meta tnum">{p.num} / {String(projects.length).padStart(2, '0')}</span>
      </nav>

      <header class:list={['cs__head', { 'cs__head--phone': phone }]}>
        <div class="cs__intro">
          <p class="meta">{p.type} · {p.year}</p>
          <h1 class="cs__title">{p.title}</h1>
          <p class="cs__one">{p.summary}</p>
          <div class="cs__links">
            {p.links.store && <a class="cs__btn cs__btn--accent" href={p.links.store} target="_blank" rel="noopener">Get it on Google Play <Icon name="arrow-up-right" size={14} /></a>}
            {gh && <a class:list={['cs__btn', { 'cs__btn--accent': !p.links.store }]} href={gh} target="_blank" rel="noopener">{p.links.github ? 'View on GitHub' : 'GitHub profile'} <Icon name="arrow-up-right" size={14} /></a>}
            {p.links.demo && <a class="cs__btn" href={p.links.demo} target="_blank" rel="noopener">Live demo <Icon name="arrow-up-right" size={14} /></a>}
          </div>
        </div>
        <div class="cs__hero">
          {heroFrames.map((src, k) => (
            <Shot src={src} frame={p.shots} alt={`${p.title} screenshot ${k + 1}`} slotPath={`work/${p.slug}/${k + 1}.png`} slotLabel={phone ? `Screen ${k + 1}` : `${p.title} visual`} compact={phone} eager class={`cs__hshot cs__hshot--${k}`} />
          ))}
        </div>
      </header>
    </div>

    <nav class="cs__tabs" aria-label="Case study sections" data-cs-tabs>
      <div class="container cs__tabs-in">
        {tabs.map((t, k) => <a href={`#${t.id}`} data-tab={t.id} aria-current={k === 0 ? 'true' : undefined}>{t.t}</a>)}
      </div>
    </nav>

    <div class="container">
      <section id="overview" class="cs__overview" data-cs-sec>
        <p class="cs__lead">{p.overview}</p>
        <dl class="cs__facts">
          {p.facts.map((f) => <div><dt><Icon name={factIcon(f.k)} size={17} />{f.k}</dt><dd>{f.v}</dd></div>)}
        </dl>
      </section>
    </div>


    <div class="container cs__body">
      <section id="problem" class="cs__row" data-cs-sec data-reveal>
        <h2 class="cs__h"><span class="tnum">01</span>The problem</h2>
        <p class="cs__p">{p.problem}</p>
      </section>
      <section id="solution" class="cs__row" data-cs-sec data-reveal>
        <h2 class="cs__h"><span class="tnum">02</span>What I built</h2>
        <p class="cs__p">{p.built}</p>
      </section>
      <section id="tech" class="cs__row" data-cs-sec data-reveal>
        <h2 class="cs__h"><span class="tnum">03</span>Tech stack</h2>
        <div>
          <ul class="cs__chips">{p.stack.map((s) => <li>{s}</li>)}</ul>
          <ul class="cs__list">{p.engineering.map((e) => <li>{e}</li>)}</ul>
        </div>
      </section>
      <section id="features" class="cs__row" data-cs-sec data-reveal>
        <h2 class="cs__h"><span class="tnum">04</span>Key features</h2>
        <ul class="cs__feats">{p.features.map((f) => <li><span class="cs__ck"><Icon name="check" size={14} /></span>{f}</li>)}</ul>
      </section>
      <section id="outcome" class="cs__row" data-cs-sec data-reveal>
        <h2 class="cs__h"><span class="tnum">05</span>Outcome</h2>
        <div class="cs__out">
          {p.metric && <p class="cs__big">{p.metric.split(' ')[0]}<span>{p.metric.split(' ').slice(1).join(' ')}</span></p>}
          <p class="cs__p">{p.outcome}</p>
        </div>
      </section>

      <a class="cs__next" href={`/work/${next.slug}`}>
        <span class="meta">Next project · {next.num}</span>
        <span class="cs__nextname">{next.title} <Icon name="arrow" size={26} class="cs__nextarr" /></span>
        <span class="cs__nextcat">{next.category} · {next.year}</span>
      </a>
    </div>
  </article>
</Base>

<script is:inline>
(() => {
  const nav = document.querySelector('[data-cs-tabs]'); if (!nav) return;
  const links = [...nav.querySelectorAll('[data-tab]')];
  const secs = links.map((l) => document.getElementById(l.dataset.tab));
  const spy = () => {
    let cur = secs[0].id;
    for (const s of secs) if (s.getBoundingClientRect().top < innerHeight * .35) cur = s.id;
    links.forEach((l) => l.dataset.tab === cur ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current'));
    const a = nav.querySelector('[aria-current]'); if (a && nav.scrollWidth > nav.clientWidth) nav.firstElementChild.scrollTo({ left: a.offsetLeft - 16, behavior: 'smooth' });
  };
  addEventListener('scroll', spy, { passive: true }); spy();
})();
</script>

<style>
  .cs__bar { display: flex; justify-content: space-between; align-items: center; padding-block: 1.25rem 0; }
  .cs__back { display: inline-flex; align-items: center; gap: .5rem; font-size: .92rem; color: var(--ink-2); padding-block: .5rem; transition: color var(--t-fast); }
  .cs__back:hover { color: var(--lime); }

  /* header: words left, the work right */
  .cs__head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; padding-block: clamp(2rem, 1.5rem + 3vw, 4rem); }
  .cs__title { margin-top: 1rem; font-size: clamp(2.6rem, 1.6rem + 4vw, 5.2rem); font-weight: 600; letter-spacing: -.05em; line-height: 1; }
  .cs__one { margin-top: 1.1rem; font-size: var(--fs-lead); color: var(--ink-2); max-width: 44ch; }
  .cs__links { margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: .6rem; }
  .cs__btn { display: inline-flex; align-items: center; gap: .5rem; min-height: 46px; padding: .65rem 1.2rem; border-radius: 999px; border: 1px solid var(--line-2); font-size: .95rem; transition: border-color var(--t-fast), color var(--t-fast), background var(--t-fast); }
  .cs__btn:hover { border-color: var(--ink-3); }
  .cs__btn--accent { border-color: var(--lime); color: var(--lime); }
  .cs__btn--accent:hover { background: var(--lime); color: var(--lime-ink); border-color: var(--lime); }
  .cs__hero { display: flex; justify-content: center; align-items: center; gap: 1rem; min-height: 22rem; }
  .cs__head--phone :global(.cs__hshot) { width: min(42%, 230px); }
  .cs__head--phone :global(.cs__hshot--0) { transform: rotate(-6deg) translateY(-.5rem); z-index: 1; }
  .cs__head--phone :global(.cs__hshot--1) { transform: rotate(5deg) translateY(1.5rem); margin-left: -2.5rem; }
  .cs__head:not(.cs__head--phone) :global(.cs__hshot) { width: 100%; }

  /* tab bar */
  .cs__tabs { position: sticky; top: 3.75rem; z-index: 20; background: rgba(11, 12, 11, .9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-block: 1px solid var(--line); }
  .cs__tabs-in { display: flex; gap: clamp(1.25rem, 3vw, 2.75rem); overflow-x: auto; scrollbar-width: none; }
  .cs__tabs-in::-webkit-scrollbar { display: none; }
  .cs__tabs a { position: relative; padding-block: 1rem; font-size: .95rem; color: var(--ink-3); white-space: nowrap; transition: color var(--t-fast); }
  .cs__tabs a:hover { color: var(--ink); }
  .cs__tabs a[aria-current="true"] { color: var(--lime); }
  .cs__tabs a::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--lime); transform: scaleX(0); transition: transform var(--t) var(--ease); }
  .cs__tabs a[aria-current="true"]::after { transform: scaleX(1); }
  section[id] { scroll-margin-top: 8.5rem; }

  /* overview: text left, facts right */
  .cs__overview { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 2rem clamp(2rem, 5vw, 5rem); padding-block: clamp(2rem, 1.5rem + 2vw, 3.25rem); }
  .cs__lead { font-size: var(--fs-lead); line-height: 1.6; color: var(--ink-2); max-width: 50ch; }
  .cs__facts { border-left: 1px solid var(--line); padding-left: clamp(1.25rem, 3vw, 2.5rem); display: grid; gap: 1.1rem; align-content: start; }
  .cs__facts > div { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 1rem; }
  .cs__facts dt { display: flex; align-items: center; gap: .65rem; color: var(--ink-3); font-size: .92rem; }
  .cs__facts dd { color: var(--ink); font-size: .95rem; }


  /* body */
  .cs__row { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 1rem clamp(2rem, 5vw, 6rem); padding-block: clamp(2rem, 1.5rem + 2vw, 3.25rem); border-bottom: 1px solid var(--line); }
  .cs__h { font-size: 1.15rem; font-weight: 600; letter-spacing: -.015em; display: flex; gap: .9rem; align-items: baseline; }
  .cs__h span { font-family: var(--f-mono); font-size: .75rem; color: var(--lime); font-weight: 400; }
  .cs__p { color: var(--ink-2); font-size: var(--fs-lead); line-height: 1.6; max-width: 58ch; }
  .cs__chips { display: flex; flex-wrap: wrap; gap: .45rem; }
  .cs__chips li { font-family: var(--f-mono); font-size: .76rem; border: 1px solid var(--line-2); border-radius: 999px; padding: .35rem .8rem; color: var(--ink); }
  .cs__list { margin-top: 1.5rem; display: grid; gap: .7rem; max-width: 58ch; }
  .cs__list li { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); color: var(--ink-2); }
  .cs__list li::before { content: "—"; color: var(--ink-3); }
  .cs__feats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .25rem 2rem; max-width: 48rem; }
  .cs__feats li { display: flex; align-items: center; gap: .8rem; padding-block: .75rem; border-bottom: 1px solid var(--line); color: var(--ink-2); }
  .cs__ck { width: 28px; height: 28px; flex: none; border: 1px solid var(--line-2); border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; color: var(--lime); }
  .cs__out { display: grid; gap: 1rem; }
  .cs__big { font-size: clamp(3rem, 2rem + 4vw, 5rem); font-weight: 600; letter-spacing: -.05em; line-height: 1; color: var(--lime); display: flex; align-items: baseline; gap: .8rem; }
  .cs__big span { font-size: 1rem; letter-spacing: 0; color: var(--ink-2); font-weight: 400; }
  .cs__next { display: grid; gap: .5rem; padding-block: clamp(3rem, 2rem + 4vw, 6rem); }
  .cs__nextname { display: inline-flex; align-items: center; gap: 1rem; font-size: clamp(2rem, 1.4rem + 2.6vw, 3.6rem); font-weight: 600; letter-spacing: -.045em; line-height: 1.05; transition: color var(--t-fast); }
  .cs__next:hover .cs__nextname { color: var(--lime); }
  .cs__next :global(.cs__nextarr) { transition: transform var(--t) var(--ease); }
  .cs__next:hover :global(.cs__nextarr) { transform: translateX(6px); }
  .cs__nextcat { color: var(--ink-3); }

  @media (prefers-reduced-motion: no-preference) {
    .cs__intro > *, .cs__hero { animation: fade .8s var(--ease) both; }
    .cs__title { animation-delay: .05s !important; } .cs__one { animation-delay: .1s !important; } .cs__links { animation-delay: .15s !important; } .cs__hero { animation-delay: .2s; }
    @keyframes fade { from { opacity: 0; transform: translateY(12px); } }
  }
  @media (max-width: 900px) {
    .cs__head, .cs__overview, .cs__row { grid-template-columns: minmax(0, 1fr); }
    .cs__hero { min-height: 0; }
    .cs__facts { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); padding-top: 1.25rem; }
  }
  @media (max-width: 520px) { .cs__feats { grid-template-columns: minmax(0, 1fr); } .cs__facts > div { grid-template-columns: minmax(0, 1fr); gap: .3rem; } }
</style>
